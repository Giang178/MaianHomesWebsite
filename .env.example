# ==============================================================================
# MAIAN HOMES SYSTEM — ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# ==============================================================================
# Copy file này thành `.env` tại thư mục root hoặc `backend/.env` và điền đầy đủ thông tin thực tế.
# CHÚ Ý: KHÔNG commit file `.env` chứa secret/mật khẩu thực lên Git!

# ------------------------------------------------------------------------------
# 1. Server / API Configuration
# ------------------------------------------------------------------------------
API_PORT=8000
ENVIRONMENT=development
DEPLOYMENT_TIER=development
DEPLOYMENT_INSTANCE_ID=development
LOAD_TEST_TARGET_MARKER=


# ------------------------------------------------------------------------------
# 2. MongoDB Database Configuration
# ------------------------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=maian_homes
DATABASE_BOOTSTRAP_MODE=auto
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_SOCKET_TIMEOUT_MS=15000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=2000


# ------------------------------------------------------------------------------
# 3. Security / JWT Configuration
# ------------------------------------------------------------------------------
SECRET_KEY=replace_this_with_your_64_char_secure_random_hex_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=480
BCRYPT_MAX_WORKERS=2
CEO_PROTECTED_EMAIL=admin@maianhomes.com
CEO_EMAIL=admin@maianhomes.com


# ------------------------------------------------------------------------------
# 4. CORS Configuration
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://maianhomes.vn,https://admin.maianhomes.vn
CSRF_ORIGIN_ENFORCEMENT=false
METRICS_ALLOWED_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
METRICS_TOKEN=
PUBLIC_SITE_URL=https://maianhomes.vn
NEXT_PUBLIC_SITE_URL=https://maianhomes.vn


# ------------------------------------------------------------------------------
# 5. Email / SMTP Configuration
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_START_TLS=true
SMTP_USER=your-smtp-account@gmail.com
SMTP_PASSWORD=your-16-char-smtp-app-password
SMTP_FROM_NAME="Maian Homes HR & System"
SMTP_FROM_EMAIL=no-reply@maianhomes.vn
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=1
CREDENTIAL_DECRYPTION_KEYS={}
ENFORCE_FIRST_LOGIN_CHANGE=true


# ------------------------------------------------------------------------------
# 6. AI / LLM Configuration (Ollama Engine)
# ------------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_REQUIRED=false
OLLAMA_HEALTH_TIMEOUT_SECONDS=5
MAYA_GROUNDED_CHAT_ENABLED=false


# ------------------------------------------------------------------------------
# 7. Storage / File Upload Configuration
# ------------------------------------------------------------------------------
UPLOAD_DIR=uploads
CONSIGNMENT_V2_ENABLED=true
LEAD_ROUTING_V2_ENABLED=true
# Marketing workflow
ACTIVITY_EMBEDDED_JOBS=true
WS_ALLOW_QUERY_TOKEN=true
WS_SESSION_RECHECK_SECONDS=60
REDIS_MAX_CONNECTIONS=64
REDIS_COMMAND_SOCKET_TIMEOUT_SECONDS=3
REDIS_POOL_WAIT_TIMEOUT_SECONDS=2
S3_MAX_POOL_CONNECTIONS=64
S3_MAX_CONCURRENCY=32
S3_OPERATION_ACQUIRE_TIMEOUT_SECONDS=2
MARKETING_TRANSACTIONS_ENABLED=false
MARKETING_WORKFLOW_ENABLED=true
MARKETING_EMBEDDED_JOBS=true
MARKETING_REVALIDATE_URL=http://localhost:3000/api/webhook/revalidate
MARKETING_REVALIDATE_SECRET=replace-with-a-random-shared-secret

# IT system operations
SYSTEM_MONITOR_REQUIRED=false
SYSTEM_MONITOR_FRONTEND_URL=http://localhost:3000
SYSTEM_MONITOR_BACKEND_URL=http://localhost:8000/health/live
SYSTEM_MONITOR_API_URL=http://localhost:8000/health/ready
SYSTEM_MONITOR_DOMAIN=
SYSTEM_MONITOR_TIMEOUT_SECONDS=8
SYSTEM_MONITOR_INTERVAL_SECONDS=60
