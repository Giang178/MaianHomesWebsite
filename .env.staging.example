# Copy to .env.staging. Replace every replace-* value before deployment.
STAGING_DOMAIN=staging.example.com
TLS_EMAIL=operations@example.com
ACTIVE_COLOR=blue
APP_RELEASE=replace-with-git-sha
DEPLOYMENT_TIER=staging
DEPLOYMENT_INSTANCE_ID=maian-staging
LOAD_TEST_TARGET_MARKER=replace-with-staging-load-target-marker
BACKEND_RELEASE_ID=replace-with-git-sha
BACKEND_BLUE_RELEASE=replace-with-git-sha
BACKEND_GREEN_RELEASE=replace-with-git-sha
BACKEND_WORKER_RELEASE=replace-with-git-sha
BACKEND_WORKER_BLUE_RELEASE=replace-with-git-sha
BACKEND_WORKER_GREEN_RELEASE=replace-with-git-sha

BACKEND_RELEASE_IMAGE=asia-southeast1-docker.pkg.dev/replace-project/maian/maian-backend:replace-sha
BACKEND_BLUE_IMAGE=asia-southeast1-docker.pkg.dev/replace-project/maian/maian-backend:replace-sha
BACKEND_GREEN_IMAGE=asia-southeast1-docker.pkg.dev/replace-project/maian/maian-backend:replace-sha
BACKEND_WORKER_IMAGE=asia-southeast1-docker.pkg.dev/replace-project/maian/maian-backend:replace-sha
BACKEND_WORKER_BLUE_IMAGE=asia-southeast1-docker.pkg.dev/replace-project/maian/maian-backend:replace-sha
BACKEND_WORKER_GREEN_IMAGE=asia-southeast1-docker.pkg.dev/replace-project/maian/maian-backend:replace-sha
FRONTEND_BLUE_IMAGE=asia-southeast1-docker.pkg.dev/replace-project/maian/maian-frontend:replace-sha
FRONTEND_GREEN_IMAGE=asia-southeast1-docker.pkg.dev/replace-project/maian/maian-frontend:replace-sha

ENVIRONMENT=production
SECRET_KEY=replace-with-at-least-64-random-characters
MONGODB_URL=mongodb://mongo1:27017/maian_staging?replicaSet=rs0
MONGODB_WIRED_TIGER_CACHE_GB=2
DATABASE_NAME=maian_staging
DATABASE_BOOTSTRAP_MODE=fresh-only
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUIRED=true
GEMINI_HEALTH_TIMEOUT_SECONDS=5
GEMINI_REQUEST_TIMEOUT_SECONDS=30
OLLAMA_IMAGE=ollama/ollama:0.32.5
OLLAMA_HOST=http://ollama:11434
# Change this tag before first deploy, or use infrastructure/gcp/switch-ollama-model.sh later.
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_REQUIRED=false
OLLAMA_HEALTH_TIMEOUT_SECONDS=5
MAYA_GROUNDED_CHAT_ENABLED=false
MAYA_LOCAL_SESSION_FALLBACK_ENABLED=false
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_SOCKET_TIMEOUT_MS=15000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=2000
UVICORN_WORKERS=2
BCRYPT_MAX_WORKERS=2
ENSURE_INDEXES_ON_STARTUP=false
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=32
REDIS_COMMAND_SOCKET_TIMEOUT_SECONDS=3
REDIS_POOL_WAIT_TIMEOUT_SECONDS=2
RATE_LIMIT_STORAGE_URI=redis://redis:6379/1
ALLOWED_ORIGINS=https://staging.example.com
CSRF_ORIGIN_ENFORCEMENT=true
TRUSTED_PROXY_CIDRS=172.16.0.0/12

ACTIVITY_EMBEDDED_JOBS=false
NOTIFICATIONS_REALTIME_ENABLED=true
WS_ALLOW_QUERY_TOKEN=false
WS_SESSION_RECHECK_SECONDS=60
NOTIFICATIONS_CHANNEL=maian:notifications:staging
NOTIFICATIONS_REALTIME_CANARY_IDS=
CONSIGNMENT_ENABLED=true

MARKETING_TRANSACTIONS_ENABLED=true
MARKETING_WORKFLOW_ENABLED=true
MARKETING_EMBEDDED_JOBS=false
MARKETING_REVALIDATE_URL=http://nginx/api/webhook/revalidate
MARKETING_REVALIDATE_SECRET=replace-with-random-revalidation-secret
PUBLIC_SITE_URL=https://staging.example.com

S3_ENABLED=true
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=replace-with-random-minio-user
S3_SECRET_KEY=replace-with-random-minio-password
S3_BUCKET=maian-staging
S3_MAX_POOL_CONNECTIONS=64
S3_MAX_CONCURRENCY=32
S3_OPERATION_ACQUIRE_TIMEOUT_SECONDS=2
MALWARE_SCAN_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

PASSWORD_RESET_ENABLED=true
ACCOUNT_CREDENTIAL_DELIVERY_ENABLED=true
ENFORCE_FIRST_LOGIN_CHANGE=true
CREDENTIAL_CANARY_EMAILS=
CREDENTIAL_ENCRYPTION_KEY=replace-with-urlsafe-base64-32-byte-key
CREDENTIAL_ENCRYPTION_KEY_VERSION=1
CREDENTIAL_DECRYPTION_KEYS={}

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_START_TLS=true
SMTP_USER=replace-smtp-user
SMTP_PASSWORD=replace-smtp-password
SMTP_FROM_EMAIL=no-reply@staging.example.com
SMTP_FROM_NAME=Maian Homes Staging
ADMIN_LOGIN_URL=https://staging.example.com/login
ADMIN_RESET_URL=https://staging.example.com/reset-password

WORKER_HEALTH_REQUIRED=true
SYSTEM_MONITOR_REQUIRED=true
SYSTEM_MONITOR_FRONTEND_URL=http://nginx/internal/active-frontend-health
SYSTEM_MONITOR_BACKEND_URL=http://api1:8000/health/live
SYSTEM_MONITOR_API_URL=http://api1:8000/health/ready
SYSTEM_MONITOR_DOMAIN=staging.example.com
METRICS_ALLOWED_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12

CEO_EMAIL=admin-staging@example.com
CEO_PROTECTED_EMAIL=admin-staging@example.com
CEO_FULL_NAME="Staging CEO"
CEO_PHONE=0900000000
CEO_BOOTSTRAP_PASSWORD=replace-with-strong-bootstrap-password
