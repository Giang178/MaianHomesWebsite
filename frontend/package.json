{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev -H 0.0.0.0",
    "dev:webpack": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev -H 0.0.0.0 --webpack",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint",
    "lint:ci": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
