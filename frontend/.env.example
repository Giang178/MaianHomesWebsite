# ==============================================================================
# MAIAN HOMES FRONTEND — ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# ==============================================================================
# Khi chuyển sang máy mới: Sao chép file này thành `.env.local` trong thư mục frontend/
# Lệnh: cp .env.example .env.local (hoặc copy .env.example .env.local trên Windows)

# 1. URL gọi trực tiếp Backend API từ phía trình duyệt (Client-side)
NEXT_PUBLIC_API_URL=http://localhost:8000

# 2. URL gọi Backend API từ phía Next.js Node server (Server-side rendering & Gateway proxy)
BACKEND_URL=http://localhost:8000

# 3. Tin cậy header proxy x-forwarded-for khi chạy sau reverse proxy/Nginx
TRUSTED_PROXY_HEADERS=true
