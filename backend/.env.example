# ==============================================================================
# MAIAN HOMES BACKEND — ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Copy file này thành `.env` và điền đầy đủ các giá trị cấu hình thực tế cho môi trường của bạn.
# CHÚ Ý: KHÔNG bao giờ commit file `.env` chứa secret/mật khẩu thực lên Git!

# ------------------------------------------------------------------------------
# 1. Server / API Configuration
# ------------------------------------------------------------------------------
# Cổng chạy API server (Mặc định: 8000)
API_PORT=8000

# Môi trường chạy ứng dụng: "development" | "staging" | "production"
# - development: Bật chế độ debug log, tắt yêu cầu cookie Secure/HTTPS
# - production: Yêu cầu cookie Secure, bật chế độ bảo mật nghiêm ngặt
ENVIRONMENT=development
DEPLOYMENT_TIER=development
DEPLOYMENT_INSTANCE_ID=development
APP_RELEASE=development
LOAD_TEST_TARGET_MARKER=


# ------------------------------------------------------------------------------
# 2. MongoDB Database Configuration
# ------------------------------------------------------------------------------
# Chuỗi kết nối MongoDB (Motor / AsyncIOMotorClient)
# Ví dụ local: mongodb://localhost:27017
# Ví dụ Replica Set / Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017/?replicaSet=rs0

# Tên database mặc định
DATABASE_NAME=maian_homes
# Local/test may use auto. Production must override this with fresh-only.
DATABASE_BOOTSTRAP_MODE=auto
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_SOCKET_TIMEOUT_MS=15000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=2000


# ------------------------------------------------------------------------------
# 3. Security / JWT Configuration
# ------------------------------------------------------------------------------
# Khóa bí mật dùng để mã hóa và xác thực JWT Access Token / Password Reset Token.
# BẮT BUỘC (CRITICAL): Phải cấu hình chuỗi ngẫu nhiên dài tối thiểu 64 ký tự hex.
# Tạo nhanh bằng lệnh terminal: `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=replace_this_with_your_64_char_secure_random_hex_secret_key

# Thời gian hết hạn của JWT Access Token (Tính bằng phút, mặc định: 480 phút = 8 giờ)
ACCESS_TOKEN_EXPIRE_MINUTES=480
BCRYPT_MAX_WORKERS=2

# Email của tài khoản CEO tối cao (Được bảo vệ vĩnh viễn ở tầng DB & Business logic chống khóa/xóa/hạ quyền)
CEO_PROTECTED_EMAIL=admin@maianhomes.com
CEO_EMAIL=admin@maianhomes.com
CEO_BOOTSTRAP_PASSWORD=Replace-With-A-Strong-Development-Password1!
CEO_FULL_NAME=
CEO_PHONE=


# ------------------------------------------------------------------------------
# 4. CORS (Cross-Origin Resource Sharing) Configuration
# ------------------------------------------------------------------------------
# Danh sách các tên miền (origins) được phép gọi API (Phân cách bằng dấu phẩy hoặc chuỗi JSON list)
# Ví dụ: http://localhost:3000,https://maianhomes.vn,https://admin.maianhomes.vn
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://172.16.100.37:3000,https://maianhomes.vn,https://admin.maianhomes.vn
CSRF_ORIGIN_ENFORCEMENT=false
METRICS_ALLOWED_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
METRICS_TOKEN=


# ------------------------------------------------------------------------------
# 5. Email / SMTP Configuration
# ------------------------------------------------------------------------------
# Cấu hình máy chủ SMTP để gửi email thông báo, tạo tài khoản và đặt lại mật khẩu
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_START_TLS=true

# Tài khoản email SMTP (Đối với Gmail, sử dụng App Password thay vì mật khẩu tài khoản thường)
SMTP_USER=your-smtp-account@gmail.com
SMTP_PASSWORD=your-16-char-smtp-app-password
LEAD_ROUTING_ENABLED=true

# Tên người gửi hiển thị trong email
SMTP_FROM_NAME="Maian Homes HR & System"
SMTP_FROM_EMAIL=no-reply@maianhomes.vn
ADMIN_LOGIN_URL=http://localhost:3000/login
ADMIN_RESET_URL=http://localhost:3000/reset-password
ADMIN_SETUP_URL=http://localhost:3000/setup-account

# Link đăng nhập/reset được nhân viên IT nhập theo từng mẫu email trong Cấu hình tài khoản.
# Sinh bằng: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=1
CREDENTIAL_DECRYPTION_KEYS={}
PASSWORD_RESET_ENABLED=true
ACCOUNT_CREDENTIAL_DELIVERY_ENABLED=true
CREDENTIAL_CANARY_EMAILS=
ENFORCE_FIRST_LOGIN_CHANGE=true
WORKER_HEALTH_REQUIRED=false
WORKER_HEARTBEAT_MAX_AGE_SECONDS=120


# ------------------------------------------------------------------------------
# 6. AI / LLM Configuration (Gemini API with optional Ollama fallback)
# ------------------------------------------------------------------------------
# Host máy chủ Ollama AI cục bộ hoặc nội bộ phục vụ phân tích hồ sơ & trợ lý AI
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUIRED=true
GEMINI_HEALTH_TIMEOUT_SECONDS=5
GEMINI_REQUEST_TIMEOUT_SECONDS=30
OLLAMA_HOST=http://localhost:11434

# Tên mô hình AI sử dụng (mặc định CPU staging: Qwen3 4B Instruct Q4_K_M)
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_REQUIRED=false
OLLAMA_HEALTH_TIMEOUT_SECONDS=5
MAYA_GROUNDED_CHAT_ENABLED=false
MAYA_LOCAL_SESSION_FALLBACK_ENABLED=false


# ------------------------------------------------------------------------------
# 7. Storage / File Upload Configuration
# ------------------------------------------------------------------------------
# Thư mục lưu trữ file tài liệu, hình ảnh tải lên bởi nhân viên (tương đối hoặc tuyệt đối)
UPLOAD_DIR=uploads
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# Bật aggregate/API Consignment; đặt false chỉ trong cửa sổ rollback có kiểm soát.
CONSIGNMENT_ENABLED=true
# Marketing workflow
ACTIVITY_EMBEDDED_JOBS=true
WS_ALLOW_QUERY_TOKEN=true
WS_SESSION_RECHECK_SECONDS=60
REDIS_MAX_CONNECTIONS=64
REDIS_COMMAND_SOCKET_TIMEOUT_SECONDS=3
REDIS_POOL_WAIT_TIMEOUT_SECONDS=2
S3_MAX_POOL_CONNECTIONS=64
S3_MAX_CONCURRENCY=32
S3_OPERATION_ACQUIRE_TIMEOUT_SECONDS=2
MARKETING_TRANSACTIONS_ENABLED=false
MARKETING_WORKFLOW_ENABLED=true
MARKETING_EMBEDDED_JOBS=true
MARKETING_REVALIDATE_URL=http://localhost:3000/api/webhook/revalidate
MARKETING_REVALIDATE_SECRET=replace-with-a-random-shared-secret

# IT system operations
SYSTEM_MONITOR_REQUIRED=false
SYSTEM_MONITOR_FRONTEND_URL=http://localhost:3000
SYSTEM_MONITOR_BACKEND_URL=http://localhost:8000/health/live
SYSTEM_MONITOR_API_URL=http://localhost:8000/health/ready
SYSTEM_MONITOR_DOMAIN=
SYSTEM_MONITOR_TIMEOUT_SECONDS=8
SYSTEM_MONITOR_INTERVAL_SECONDS=60
SYSTEM_MONITOR_EXPECTED_WORKERS=activity-worker,system-monitor-worker
